generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GovtCategory {
  CENTRAL
  STATE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PREPARER
}

enum OrganizationStatus {
  ACTIVE
  DISABLED
}

enum StatementType {
  ORIGINAL
  CORRECTION_M
  CORRECTION_X
}

enum DdoMode {
  ADD
  UPDATE
  DELETE
  NO_CHANGE
}

enum RecordStatus {
  STAGING
  VALIDATED
  FINAL
}

enum GeneratedFileStatus {
  PENDING
  FVU_PASSED
  FVU_FAILED
}

enum FilingPeriodStatus {
  DRAFT
  LOCKED
}

/** A Tax Professional firm (or the platform operator itself, for the seeded SUPER_ADMIN). */
model Organization {
  id           String  @id @default(cuid())
  name         String
  contactEmail String?
  contactPhone String?

  status OrganizationStatus @default(ACTIVE)

  /** This firm's own SMTP config — set by the firm's own ADMIN from their Profile, used for password-reset
   *  emails to their own staff and any future mail the firm sends to their own Clients. Falls back to the
   *  platform's own SMTP settings, then env vars, when unset. */
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  subscriptions Subscription[]
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentMethod {
  MANUAL
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

/**
 * One firm's subscription to one product (e.g. this firm's "Nex TDS" line item),
 * each with its own price, billing cycle, and validity window — replaces the old
 * single shared `Organization.enabledApplications`/`subscriptionStartDate/EndDate`,
 * since firms can subscribe to different products on different terms and dates.
 * A product only counts as entitled (usable) while status is ACTIVE and endDate
 * hasn't passed yet — see `isSubscriptionActive` in src/lib/subscriptions.ts.
 */
model Subscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /** "FORM137" | "TDS" | "GST" — matches ApplicationTypeKey in src/lib/applicationTypes.ts. */
  application  String
  price        Decimal            @db.Decimal(10, 2)
  billingCycle BillingCycle       @default(MONTHLY)
  startDate    DateTime?
  endDate      DateTime?
  status       SubscriptionStatus @default(PENDING_PAYMENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SubscriptionPayment[]

  @@unique([organizationId, application])
}

/** A single payment (or payment attempt) against a Subscription — manual (recorded by the
 *  super admin, e.g. bank transfer/UPI) or via Razorpay (payment link, tracked to completion). */
model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod @default(MANUAL)
  status      PaymentStatus @default(PENDING)
  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  /** For a manual payment: a reference note (bank transfer ref, UPI txn ID, etc). */
  notes       String?

  razorpayPaymentLinkId  String?
  razorpayPaymentLinkUrl String?
  razorpayPaymentId      String?

  createdAt DateTime @default(now())

  @@index([subscriptionId])
}

/** Platform-wide default price per product, set by the super admin — prefills the price
 *  shown when onboarding a firm or adding a product to an existing one (still editable
 *  per-firm from there, e.g. for a negotiated discount). */
model ProductPrice {
  /** "FORM137" | "TDS" | "GST" */
  application  String       @id
  price        Decimal      @db.Decimal(10, 2)
  billingCycle BillingCycle @default(MONTHLY)
  updatedAt    DateTime     @updatedAt
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           UserRole     @default(PREPARER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  disabled          Boolean   @default(false)
  /** Forces the change-password flow on next login — set after a super-admin password reset. */
  mustChangePassword Boolean  @default(false)
  lastLoginAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]
}

/**
 * A single-use, time-limited self-service "forgot password" link. Only the
 * SHA-256 hash of the token is stored — like a password — so a database
 * leak alone can't be used to reset anyone's account; the raw token only
 * ever exists in the emailed link itself.
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/** An actual filing entity (Accounts Office/DTO/CDDO) that a Tax Professional firm files returns for. */
model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /** Which return type(s) this client files, chosen at onboarding — a subset of the firm's own enabledApplications. */
  enabledReturnTypes String[]   @default(["FORM137"])

  ain              String       @unique
  tan              String?
  ministryName     String?
  /** Mandatory when AO Category = Central government (Annexure 4). */
  subMinistryName  String?
  departmentName   String
  govtCategory   GovtCategory
  /** Annexure 8 country code. Mandatory on BH from FY2026-27 (F137) onward. */
  countryCode    String?

  /** Used for FY2025-26 and earlier (legacy 24G); superseded by the split name fields below from FY2026-27 onward. */
  responsiblePersonName        String?
  responsiblePersonFirstName   String?
  responsiblePersonMiddleName  String?
  responsiblePersonLastName    String?
  responsiblePersonDesignation String
  responsiblePersonAddress1    String
  responsiblePersonAddress2    String?
  responsiblePersonAddress3    String?
  responsiblePersonAddress4    String?
  responsiblePersonCity        String
  responsiblePersonState       String
  responsiblePersonPin         String
  responsiblePersonStdCode     String?
  responsiblePersonPhone       String?
  responsiblePersonMobile      String?
  responsiblePersonEmail       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  filingPeriods FilingPeriod[]
  ddoMasters    DdoMaster[]

  @@index([organizationId])
}

/** Reusable DDO identity/contact details for a Client, entered once and selected on each filing. */
model DdoMaster {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  tan  String
  name String

  // Legacy (FY2025-26 and earlier) DDO address fields — not applicable from FY2026-27 onward
  address1 String?
  address2 String?
  address3 String?
  address4 String?
  city     String?
  state    String?
  pin      String?
  ddoRegNo String?
  ddoCode  String?
  email    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ddoRecords DdoRecord[]

  @@unique([clientId, tan])
}

model FilingPeriod {
  id            String        @id @default(cuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  financialYear Int
  month         Int
  statementType StatementType @default(ORIGINAL)
  schemaVersion String        @default("v1_9")

  status        FilingPeriodStatus @default(DRAFT)
  lockedAt      DateTime?
  receiptNumber String?
  receiptDate   DateTime?

  ddoRecords     DdoRecord[]
  generatedFiles GeneratedFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, financialYear, month, statementType])
}

model DdoRecord {
  id             String       @id @default(cuid())
  filingPeriodId String
  filingPeriod   FilingPeriod @relation(fields: [filingPeriodId], references: [id], onDelete: Cascade)

  /** Nullable at the DB level for backward compatibility; the API requires it for all new entries. */
  ddoMasterId String?
  ddoMaster   DdoMaster? @relation(fields: [ddoMasterId], references: [id], onDelete: SetNull)

  serialNo Int
  // tan/name (and the address fields below) are a SNAPSHOT copied from the
  // selected DdoMaster at save time, not a live reference — once a period is
  // LOCKED its filed data must stay exactly what was actually submitted even
  // if the DDO's master record is edited later.
  tan      String
  name     String

  // Legacy (FY2025-26 and earlier) DDO address fields — not applicable from FY2026-27 onward
  address1  String?
  address2  String?
  address3  String?
  address4  String?
  city      String?
  state     String?
  pin       String?
  ddoRegNo  String?
  ddoCode   String?
  email     String?

  taxDeducted        Decimal @db.Decimal(15, 2)
  formType            String?
  totalRemitted       Decimal @db.Decimal(15, 2)
  natureOfDeduction   String?

  mode   DdoMode      @default(ADD)
  status RecordStatus @default(STAGING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([filingPeriodId])
  @@unique([filingPeriodId, ddoMasterId, formType])
}

model GeneratedFile {
  id             String              @id @default(cuid())
  filingPeriodId String
  filingPeriod   FilingPeriod        @relation(fields: [filingPeriodId], references: [id], onDelete: Cascade)

  rawTextPath      String
  fvuFilePath      String?
  statisticFilePath String?
  errHtmlPath      String?
  receiptPath      String?
  fvuVersion       String
  status           GeneratedFileStatus @default(PENDING)

  createdAt DateTime @default(now())
}

/** Singleton row (id="singleton") caching the last FVU-version scrape, so pages don't hit Protean's site on every load. */
model FvuVersionStatus {
  id               String   @id @default("singleton")
  supportedVersion String
  detectedVersion  String?
  isNewer          Boolean  @default(false)
  checkedAt        DateTime @default(now())
}

/**
 * Singleton row (id="singleton") holding platform-level notification config,
 * set by the super admin from their own Profile page instead of .env — so
 * SMTP/Slack credentials are entered directly in the app, not shared out of
 * band. Falls back to the equivalent env vars when unset (see notify.ts).
 */
model PlatformSettings {
  id             String  @id @default("singleton")
  smtpHost       String?
  smtpPort       Int?
  smtpUser       String?
  smtpPassword   String?
  alertEmailTo   String?
  slackWebhookUrl String?

  /** Razorpay platform account, used to generate hosted payment links for firm subscription
   *  renewals/onboarding. `razorpayWebhookSecret` is the separate secret Razorpay signs webhook
   *  payloads with (configured on their dashboard) — distinct from the API key secret. */
  razorpayKeyId         String?
  razorpayKeySecret     String?
  razorpayWebhookSecret String?

  /** When true, a product a firm hasn't subscribed to (e.g. Nex TDS/GST) is omitted
   *  entirely from their dashboard instead of shown locked/grayed out. */
  hideUnsubscribedModules Boolean @default(false)

  updatedAt DateTime @updatedAt
}
